			{
				"id": "post-code",
				"slug": "code-blocks",
				"status": "published",
				"data": {
					"title": "コードブロックの表示",
					"excerpt": "コードブロックは Shiki で色付けされ、ライトとダークの切り替えに追従します。",
					"featured_image": {
						"$media": {
							"url": "https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=1200&h=800&fit=crop",
							"alt": "Code on a monitor in a dark room",
							"filename": "building-long-term.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "コードブロックは、言語を指定すると色付けされます。ファイル名を付けると、ブロックの上に表示されます。",
									"_key": "k29"
								}
							],
							"_key": "k28"
						},
						{
							"_type": "code",
							"code": "body {\n\tword-break: auto-phrase;\n\tline-break: strict;\n}",
							"language": "css",
							"_key": "k30",
							"filename": "src/styles/theme.css"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "色はライトモードとダークモードで切り替わります。画面右上の切り替えボタンで確かめてください。",
									"_key": "k32"
								}
							],
							"_key": "k31"
						},
						{
							"_type": "code",
							"code": "npm create emdash@latest my-blog\ncd my-blog\nnpm install\nnpm run dev",
							"language": "bash",
							"_key": "k33"
						}
					]
				},
