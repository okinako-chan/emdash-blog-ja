				{
					"type": "component",
					"componentId": "core:tags",
					"title": "タグ"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "最近の投稿",
					"props": {
						"count": 5,
						"showDate": false
					}
				}
			]
		},
		{
			"name": "footer",
			"label": "フッター",
			"description": "サイトのフッターに表示するウィジェット",
			"widgets": []
