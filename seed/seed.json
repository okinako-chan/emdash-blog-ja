								}
							],
							"_key": "k10",
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "「このブログについて」のページを書き換える",
									"_key": "k13"
								}
							],
							"_key": "k12",
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "メニューとウィジェットを、管理画面から好みに合わせて並べ替える",
									"_key": "k15"
								}
